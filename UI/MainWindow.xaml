<Window x:Class="JFlightShaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="JFlightShaker C.E"
        Icon="/Assets/JFlightCE-0.4.png"
        Width="1100"
        Height="640"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <sys:String x:Key="TestButtonText">Probar</sys:String>
        <Style x:Key="EffectCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#EEF5FF"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BindingCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#F6F1FF"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BindingTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="IntensityCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#FFF8E5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TestCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#F0F5F8"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#ECF8F0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EngineButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/JFlightCE-Logo.png"
                           Width="52"
                           Height="52"
                           Stretch="Uniform"
                           Margin="0,0,13,0"
                           SnapsToDevicePixels="True"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JFlightShaker"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="Motor háptico universal para simuladores de vuelo"
                                   Foreground="#AAB7CE"
                                   FontSize="12"
                                   Margin="1,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="StartStopBtn"
                        Grid.Column="1"
                        Content="Start"
                        Style="{StaticResource EngineButtonStyle}"
                        Background="#2EAD63"
                        Width="112"
                        Height="42"
                        FontWeight="SemiBold"
                        FontSize="14"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="AudioSectionLabel"
                                   Text="SALIDA DE AUDIO"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AudioDevices" MinWidth="280"/>
                            <Button x:Name="RefreshAudioBtn"
                                    Grid.Column="1"
                                    Content="↻"
                                    Width="34"
                                    Height="34"
                                    MinHeight="34"
                                    Padding="0"
                                    Margin="7,0,0,0"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    ToolTip="Refrescar dispositivos de audio"/>
                            <Ellipse x:Name="AudioStatusIndicator"
                                     Grid.Column="2"
                                     Width="11"
                                     Height="11"
                                     Margin="10,0,2,0"
                                     VerticalAlignment="Center"
                                     Fill="#BE6969"
                                     Stroke="#704040"
                                     StrokeThickness="1"
                                     ToolTip="Audio device disconnected"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="1"
                            Background="#E4E9F1"
                            HorizontalAlignment="Center"
                            Margin="0,1"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="InputSectionLabel"
                                   Text="DISPOSITIVO DE ENTRADA"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="InputDevices" MinWidth="280"/>
                            <Button x:Name="RefreshDevicesBtn"
                                    Grid.Column="1"
                                    Content="↻"
                                    Width="34"
                                    Height="34"
                                    MinHeight="34"
                                    Padding="0"
                                    Margin="7,0,0,0"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    ToolTip="Refrescar dispositivos"/>
                            <Button x:Name="TestDeviceBtn"
                                    Grid.Column="2"
                                    Content="Probar"
                                    MinWidth="78"
                                    Margin="7,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0"
                    ClipToBounds="True">
                <DataGrid x:Name="BindingsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="False"
                          AlternationCount="2"
                          BorderThickness="0"
                          PreviewMouseDown="BindingsGrid_PreviewMouseDown"
                          PreviewMouseRightButtonDown="BindingsGrid_PreviewMouseRightButtonDown"
                          MouseDoubleClick="BindingsGrid_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMuteEffect}" Value="True">
                                    <Setter Property="Margin" Value="0,8,0,0"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DCEAFF"/>
                                    <Setter Property="Foreground" Value="#172033"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="EditBindingMenuItem" Header="Edit" Click="EditBindingMenuItem_Click"/>
                            <MenuItem x:Name="UnbindBindingMenuItem" Header="Unbind Selected" Click="UnbindMenuItem_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="EffectColumn" Header="Efecto"
                                                Width="1.35*" CellStyle="{StaticResource EffectCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EffectName}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Description}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="BindingColumn" Header="Asignación"
                                            Binding="{Binding BindingText}" Width="3.25*"
                                            CellStyle="{StaticResource BindingCellStyle}"
                                            ElementStyle="{StaticResource BindingTextStyle}"/>
                        <DataGridTemplateColumn x:Name="IntensityColumn" Header="Intensidad"
                                                Width="1.7*" CellStyle="{StaticResource IntensityCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SupportsIntensity}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="0"
                                                Maximum="1"
                                                TickFrequency="0.05"
                                                IsEnabled="{Binding CanAdjustIntensity}"
                                                Value="{Binding Intensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding IntensityPercent}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="TestColumn" Header="Prueba"
                                                Width="86" CellStyle="{StaticResource TestCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{DynamicResource TestButtonText}"
                                            Padding="10,4"
                                            MinHeight="28"
                                            IsEnabled="{Binding CanTest}"
                                            ToolTip="Preview this effect for 1.5 seconds"
                                            Click="TestEffectButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="StatusColumn" Header="Estado"
                                                Width="1.2*" CellStyle="{StaticResource StatusCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayStatus}"
                                               Foreground="{Binding StatusBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="2" Margin="2,12,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionLabel"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,14,0"/>
                    <TextBlock x:Name="LanguageLabel"
                               Text="Idioma:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,6,0"/>
                    <ComboBox x:Name="LanguageCombo"
                              MinWidth="126"
                              MinHeight="30"
                              Padding="6,2"
                              SelectedIndex="0"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Tag="es" Content="Español"/>
                        <ComboBoxItem Tag="en" Content="English"/>
                        <ComboBoxItem Tag="ca" Content="Català"/>
                        <ComboBoxItem Tag="fr" Content="Français"/>
                        <ComboBoxItem Tag="de" Content="Deutsch"/>
                        <ComboBoxItem Tag="it" Content="Italiano"/>
                        <ComboBoxItem Tag="pt" Content="Português"/>
                        <ComboBoxItem Tag="pl" Content="Polski"/>
                        <ComboBoxItem Tag="zh" Content="中文（简体）"/>
                        <ComboBoxItem Tag="ja" Content="日本語"/>
                        <ComboBoxItem Tag="ko" Content="한국어"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="LastInputCaption"
                               Text="Última entrada:"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,7,0"/>
                    <TextBlock x:Name="LastInputLabel"
                               Text="None"
                               Foreground="#214D88"
                               FontWeight="SemiBold"
                               MaxWidth="360"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="OpenConfigBtn"
                        Grid.Column="2"
                        Content="Abrir carpeta de configuración"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <Image Grid.Row="1"
               Source="/Assets/JFlightCE-Background.png"
               Width="470"
               MaxHeight="470"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="Uniform"
               Opacity="0.075"
               IsHitTestVisible="False"
               Focusable="False"
               Panel.ZIndex="50"/>
    </Grid>
</Window>
