<Window x:Class="JFlightShaker.UI.KeyboardBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Keyboard Key"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Key:" VerticalAlignment="Center" Margin="0,0,8,10"/>
        <TextBox x:Name="KeyTextBox"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Height="28"
                 Margin="8,0,8,10"
                 Padding="6,0"
                 VerticalContentAlignment="Center"/>
        <Button x:Name="ListenBtn"
                Grid.Column="2"
                Content="Listen"
                Height="28"
                Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1"
                   Text="Mode:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,10"/>
        <ComboBox x:Name="TriggerCombo"
                  Grid.Row="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Height="28"
                  Margin="8,0,0,10"
                  VerticalContentAlignment="Center">
            <ComboBoxItem Content="Trigger"/>
            <ComboBoxItem Content="Hold"/>
        </ComboBox>

        <StackPanel Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" Width="90" Height="28" Margin="0,0,8,0"/>
            <Button x:Name="SaveBtn" Content="Save" Width="90" Height="28"/>
        </StackPanel>
    </Grid>
</Window>
